# Price-Select environment variables.
#
# Local development: copy to .env.local (git-ignored) and fill in values.
# Production (Vercel or another host): set the same variables in the hosting dashboard.
# .env.local is NOT deployed. Never commit real values. Server secrets must never use NEXT_PUBLIC_.

# ---------------------------------------------------------------- required

# MongoDB Atlas connection string (Atlas → Connect → Drivers). Atlas clusters are replica sets,
# which checkout transactions require.
MONGODB_URI=
# Database name inside the cluster, e.g. price-select-dev / price-select-prod.
MONGODB_DB_NAME=

# Session signing/encryption secret for Better Auth. 32+ random characters, e.g.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app, used for auth callbacks and trusted-origin checks.
# Local: http://localhost:3000   Production: https://price-select.com
BETTER_AUTH_URL=

# Public site origin (canonical URLs, sitemap, email links). Safe to expose.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------- recommended

# Shared secret for /api/jobs/run (releases expired stock holds, delivers queued email, cleans
# abandoned uploads, expires memberships). Vercel Cron sends it as "Authorization: Bearer <secret>".
CRON_SECRET=

# ---------------------------------------------------------------- integrations (optional)
#
# No payment or email provider has been selected yet. Leave these unset: checkout, refunds,
# membership purchase and email delivery then report "not configured" honestly instead of faking
# success. The value "test" enables built-in test adapters for automated tests and local
# development ONLY; it is ignored when NODE_ENV=production.
PAYMENT_PROVIDER=
EMAIL_PROVIDER=

# ---------------------------------------------------------------- scripts only (not needed at runtime)

# npm run bootstrap:staff -- --role=admin
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_NAME=

# npm run seed -- --confirm=<MONGODB_DB_NAME> --accounts
SEED_SUPPLIER_PASSWORD=
